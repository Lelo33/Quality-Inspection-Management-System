# ---------------- Reference solution ----------------
def pass_rate_solution(results):
    if not results:
        return 0.0
    passes = sum(1 for r in results if r == "pass")
    return round(100 * passes / len(results), 1)


def failed_positions_solution(results):
    return [i for i, r in enumerate(results, start=1) if r != "pass"]


